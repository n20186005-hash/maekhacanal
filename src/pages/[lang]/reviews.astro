---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reviews from '../../components/Reviews.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { languagesList, getI18n } from '../../i18n/ui';

export const prerender = true;
export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}
const { lang, messages } = await getI18n(Astro.url);
---

<BaseLayout lang={lang} title={`${messages.reviews.heading} — ${messages.footer.brand.name}`} description={messages.reviews.intro} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main class="pt-16 min-h-[70vh] bg-teakDeep">
    <Reviews lang={lang} messages={messages} />
    <div class="max-w-5xl mx-auto px-5 pb-12"><a href={`/${lang}/`} class="text-goldBright underline">← {messages.header.home}</a></div>
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
