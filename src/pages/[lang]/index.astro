---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import History from '../../components/History.astro';
import Guide from '../../components/Guide.astro';
import Food from '../../components/Food.astro';
import Gallery from '../../components/Gallery.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
import SeoGuides from '../../components/SeoGuides.astro';
import NearbyExplore from '../../components/NearbyExplore.astro';
import { languagesList, defaultLang, getI18n } from '../../i18n/ui';

export async function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = await getI18n(Astro.url);
---

<BaseLayout lang={lang} title={messages.meta.title} description={messages.meta.description} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} />
    <About messages={messages} />
    <Ecosystem messages={messages} />
    <History messages={messages} />
    <Guide messages={messages} />
    <SeoGuides lang={lang} />
    <NearbyExplore lang={lang} />
    <Food messages={messages} />
    <Gallery messages={messages} />
    <section class="bg-teakDeep text-ivory py-12" aria-label="Reviews and sources">
      <div class="max-w-5xl mx-auto px-5 grid sm:grid-cols-2 gap-6">
        <a href={`/${lang}/reviews/`} class="rounded-2xl border border-gold/30 p-6 hover:border-goldBright transition-colors">
          <h2 class="font-display text-2xl text-goldBright">{messages.reviews.heading}</h2>
          <p class="mt-2 text-sm text-ivory/70">{messages.reviews.intro}</p>
        </a>
        <a href={`/${lang}/sources/`} class="rounded-2xl border border-gold/30 p-6 hover:border-goldBright transition-colors">
          <h2 class="font-display text-2xl text-goldBright">{messages.sources.heading}</h2>
          <p class="mt-2 text-sm text-ivory/70">{messages.sources.intro}</p>
        </a>
      </div>
    </section>
    <MapSection lang={lang} messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
