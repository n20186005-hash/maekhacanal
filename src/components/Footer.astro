---
interface Props {
  lang: any;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const footer = messages.footer;
---

<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 text-center text-sm text-ivory/75 space-y-2">
    <p>{footer.copyright}</p>
    <p>{footer.unofficial}</p>
  </div>
</footer>
