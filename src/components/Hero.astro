function iconFor(code: number): string {
  if (code === 0) return '☀️';
  if (code <= 2) return '🌤️';
  if (code === 3) return '☁️';
  if (code === 45 || code === 48) return '🌫️';
  if (code >= 51 && code <= 57) return '🌦️';
  if (code >= 61 && code <= 67) return '🌧️';
  if (code >= 71 && code <= 77) return '❄️';
  if (code >= 80 && code <= 82) return '🌦️';
  if (code >= 95) return '⛈️';
  return '🌡️';
}

type Advice4 = {
  dressing: string[];
  schedule: string[];
  carry: string[];
  risk: string[];
};

type WeatherData = {
  ok: boolean;
  code: number;
  temp: number;
  wind: number;
  hum: number;
  uv: number;
  precipProb0: number;
  tMax: number;
  tMin: number;
  icon: string;
  title: string;
  short: string;
  golden: string;
  sunset: string;
  blue: string;
  days: Array<{ week: string; icon: string; hi: number; lo: number; prob: number }>;
  advice: Advice4;
  uvText: string;
  humText: string;
};

const tip = TIP_LIB[lang] ?? TIP_LIB.en;
const lab = (LABELS as any)[lang] ?? LABELS.en;

function buildAdvice(o: { code: number; temp: number; tMax: number; tMin: number; wind: number; uv: number; hum: number; precipProb0: number }): Advice4 {
  const res: Advice4 = { dressing: [], schedule: [], carry: [], risk: [] };
  const { code, temp, tMax, tMin, wind, uv, hum, precipProb0 } = o;
  const isRainAny = (code >= 51 && code <= 67) || (code >= 80 && code <= 82);
  const isHeavy = code === 65 || code === 82 || (code >= 95 && code <= 99);
  const isStorm = code >= 95;
  const isFog = code === 45 || code === 48;
  const isClear = code <= 1;
  const isOvercast = code === 2 || code === 3;

  // 🧥 Dressing
  if (hum >= 80 || (temp >= 28 && hum >= 65)) res.dressing.push(tip.muggy);
  if (tMax - tMin > 8) res.dressing.push(tip.bigRange);
  if (temp >= 32) res.dressing.push(tip.hot);
  if (tMax <= 10) res.dressing.push(tip.cold);
  if (isRainAny && isHeavy) res.dressing.push(tip.rainHeavy);
  if (isRainAny && !isHeavy) res.dressing.push(tip.drizzle);
  if (wind >= 29 && wind < 39) res.dressing.push(tip.windy);
  if (wind >= 39) res.dressing.push(tip.stormWind);
  if (uv >= 5) res.dressing.push(tip.uvHigh);
  if (isClear && temp < 32) res.dressing.push(tip.sunny);
  if (isOvercast && !isRainAny) res.dressing.push(tip.overcast);
  if (isFog) res.dressing.push(tip.fog);
  if (precipProb0 >= 60 && !isRainAny) res.dressing.push(tip.probHigh);
  if (isStorm) res.risk.push(tip.thunder);
  if (wind >= 39 && !isStorm) res.risk.push(tip.stormWind);
  if (isHeavy && !isStorm && wind < 39) res.risk.push(tip.rainHeavy);
  if (isFog) res.risk.push(tip.fog);

  // 🗺️ Schedule（结合『运河河湖』+『城市人文』场景）
  if (isStorm) {
    res.schedule.push(tip.canalThunder);
  } else if (isHeavy) {
    res.schedule.push(tip.canalRain);
  } else if (wind >= 39) {
    res.schedule.push(tip.canalWind);
  } else if (isFog) {
    res.schedule.push(tip.canalFog);
  } else if (temp >= 32) {
    res.schedule.push(tip.hot);
    res.schedule.push(tip.canalGood);
  } else if (isRainAny) {
    res.schedule.push(tip.canalRain);
  } else if (isClear || isOvercast) {
    res.schedule.push(tip.canalGood);
  }
  if (isFog) res.schedule.push(tip.canalFog);

  // 🎒 Carry（动态只加需要的）
  if (uv >= 5) { res.carry.push(tip.needSunblock); res.carry.push(tip.needSunglasses); res.carry.push(tip.needHat); }
  if (temp >= 28) { res.carry.push(tip.needWater); if (hum >= 75) res.carry.push(tip.needFan); }
  if (precipProb0 >= 60 || isRainAny) {
    if (isHeavy || wind >= 29) res.carry.push(tip.needRaincoat);
    else res.carry.push(tip.needUmbrella);
    res.carry.push(tip.needShoes);
  }
  if (tMax - tMin > 8 || tMax <= 18) res.carry.push(tip.needCoat);
  if (tMax <= 10) res.carry.push(tip.needThickCoat);
  if (isFog) res.carry.push(tip.needMask);
  if (code <= 3 && temp >= 22 && hum >= 60) res.carry.push(tip.needMosquito);
  // 去重
  const uniq = (a: string[]) => Array.from(new Set(a));
  res.dressing = uniq(res.dressing);
  res.schedule = uniq(res.schedule);
  res.carry = uniq(res.carry);
  res.risk = uniq(res.risk);
  return res;
}

const pad = (n: number) => String(n).padStart(2, '0');
const fmtHHMM = (iso: string) => { const d = new Date(iso); return pad(d.getHours()) + ':' + pad(d.getMinutes()); };
const addMinToIso = (iso: string, m: number) => { const d = new Date(new Date(iso).getTime() + m * 60000); return pad(d.getHours()) + ':' + pad(d.getMinutes()); };

const fallback = (): WeatherData => {
  const code = 2;
  const advice = buildAdvice({ code, temp: 27, tMax: 31, tMin: 22, wind: 6, uv: 5, hum: 70, precipProb0: 30 });
  const wm = WEATHER_CODES[code][lang] ?? WEATHER_CODES[code].en;
  return {
    ok: false,
    code, temp: 27, wind: 6, hum: 70, uv: 5, precipProb0: 30, tMax: 31, tMin: 22,
    icon: iconFor(code), title: wm.t, short: wm.s,
    golden: hero.defaultGolden, sunset: hero.defaultSunset, blue: hero.defaultBlue,
    days: [], advice,
    uvText: (uv: number) => (uv >= 8 ? '很强' : uv >= 5 ? '强' : uv >= 3 ? '中' : '弱') as unknown as string,
    humText: (h: number) => (h >= 80 ? '很高' : h >= 65 ? '较高' : h >= 45 ? '舒适' : '偏干') as unknown as string,
  } as unknown as WeatherData;
};

let weather: WeatherData = fallback();

try {
  const CACHE_TTL = 1000 * 60 * 20;
  const cacheStore = (globalThis as any).__maeKhaWeatherCache || new Map<string, { v: WeatherData; t: number }>();
  (globalThis as any).__maeKhaWeatherCache = cacheStore;
  const cacheKey = `${siteConfig.coords.lat}-${siteConfig.coords.lng}-${lang}-v2`;
  const cachedEntry = cacheStore.get(cacheKey);
  if (cachedEntry && Date.now() - cachedEntry.t < CACHE_TTL) {
    weather = cachedEntry.v;
  } else {
    const url =
      `https://api.open-meteo.com/v1/forecast?latitude=${siteConfig.coords.lat}` +
      `&longitude=${siteConfig.coords.lng}` +
      `&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,precipitation_probability` +
      `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,wind_speed_10m_max,uv_index_max,sunrise,sunset` +
      `&timezone=Asia/Bangkok&wind_speed_unit=kmh&forecast_days=7`;
    const res = await fetch(url, { signal: AbortSignal.timeout(4000) });
    if (!res.ok) throw new Error('fetch fail');
    const d = await res.json();
    if (!d?.current || !d?.daily) throw new Error('bad payload');

    const code = d.current.weather_code as number;
    const temp = Math.round(d.current.temperature_2m as number);
    const wind = Math.round(d.current.wind_speed_10m as number);
    const hum = Math.round(d.current.relative_humidity_2m as number);
    const uv = Math.round((d.daily.uv_index_max as number[])[0] ?? 0);
    const precipProb0 = Math.round((d.daily.precipitation_probability_max as number[])[0] ?? 0);
    const tMax = Math.round((d.daily.temperature_2m_max as number[])[0] ?? temp + 3);
    const tMin = Math.round((d.daily.temperature_2m_min as number[])[0] ?? temp - 5);
    const wm = WEATHER_CODES[code]?.[lang] ?? WEATHER_CODES[code]?.en ?? WEATHER_CODES[3][lang];
    const week: string[] = (hero.week7 as string[]) ?? ['今天', '明天', '后天', '周四', '周五', '周六', '周日'];
    const days = (d.daily.weather_code as number[]).slice(0, 7).map((c, i) => ({
      week: week[i] ?? '',
      icon: iconFor(c),
      hi: Math.round((d.daily.temperature_2m_max as number[])[i]),
      lo: Math.round((d.daily.temperature_2m_min as number[])[i]),
      prob: Math.round((d.daily.precipitation_probability_max as number[])[i]),
    }));

    const advice = buildAdvice({ code, temp, tMax, tMin, wind, uv, hum, precipProb0 });
    const uvHuman = uv >= 8 ? (lang === 'zh' ? '很强' : lang === 'th' ? 'แรงมาก' : 'Very high') : uv >= 5 ? (lang === 'zh' ? '强' : lang === 'th' ? 'แรง' : 'High') : uv >= 3 ? (lang === 'zh' ? '中' : lang === 'th' ? 'ปานกลาง' : 'Moderate') : (lang === 'zh' ? '弱' : lang === 'th' ? 'อ่อน' : 'Low');
    const humHuman = hum >= 80 ? (lang === 'zh' ? '很高' : lang === 'th' ? 'มาก' : 'Very humid') : hum >= 65 ? (lang === 'zh' ? '较高' : lang === 'th' ? 'ค่อนข้างสูง' : 'Humid') : hum >= 45 ? (lang === 'zh' ? '舒适' : lang === 'th' ? 'สบาย' : 'Comfortable') : (lang === 'zh' ? '偏干' : lang === 'th' ? 'ค่อนข้างแห้ง' : 'Dry');

    weather = {
      ok: true, code, temp, wind, hum, uv, precipProb0, tMax, tMin,
      icon: iconFor(code), title: wm.t, short: wm.s,
      golden: fmtHHMM(d.daily.sunrise[0]) + ' – ' + addMinToIso(d.daily.sunrise[0], 90),
      sunset: fmtHHMM(d.daily.sunset[0]),
      blue: addMinToIso(d.daily.sunset[0], 20) + ' – ' + addMinToIso(d.daily.sunset[0], 50),
      days, advice,
      uvText: uvHuman, humText: humHuman,
    };
    cacheStore.set(cacheKey, { v: weather, t: Date.now() });
  }
} catch {
  weather = fallback();
  (weather as any).uvText = weather.uv >= 8 ? (lang === 'zh' ? '很强' : lang === 'th' ? 'แรงมาก' : 'Very high') : weather.uv >= 5 ? (lang === 'zh' ? '强' : lang === 'th' ? 'แรง' : 'High') : weather.uv >= 3 ? (lang === 'zh' ? '中' : lang === 'th' ? 'ปานกลาง' : 'Moderate') : (lang === 'zh' ? '弱' : lang === 'th' ? 'อ่อน' : 'Low');
  (weather as any).humText = weather.hum >= 80 ? (lang === 'zh' ? '很高' : lang === 'th' ? 'มาก' : 'Very humid') : weather.hum >= 65 ? (lang === 'zh' ? '较高' : lang === 'th' ? 'ค่อนข้างสูง' : 'Humid') : weather.hum >= 45 ? (lang === 'zh' ? '舒适' : lang === 'th' ? 'สบาย' : 'Comfortable') : (lang === 'zh' ? '偏干' : lang === 'th' ? 'ค่อนข้างแห้ง' : 'Dry');
}
---

<section id="home" class="relative min-h-screen flex items-end overflow-hidden">
  <img src={heroImg} alt={`${siteConfig.attractionFullName[lang]} — Main view in ${siteConfig.cityName[lang]}, ${siteConfig.countryName[lang]}`} class="absolute inset-0 w-full h-full object-cover" loading="eager" />
  <div class="absolute inset-0 bg-gradient-to-t from-teakDeep via-teakDeep/70 to-teak/40"></div>
  <div class="hero-glow absolute inset-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full px-5 pb-16 pt-28 grid lg:grid-cols-12 gap-10 items-end">
    <div class="lg:col-span-7 text-ivory">
      <p class="font-hand text-gold text-xl md:text-2xl mb-3">{hero.eyebrow}</p>
      <h1 class="font-display font-semibold leading-[1.05] text-5xl md:text-7xl lg:text-8xl text-ivory">
        {parts[0]}<span class="gold-text-bright">{accent}</span>{parts[1] ?? ''}
      </h1>
      <p class="mt-6 max-w-xl text-ivory/85 text-lg md:text-xl">{hero.subtitle}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#guide" class="inline-flex items-center gap-2 bg-gold text-teak font-semibold px-6 py-3 rounded-full hover:bg-goldBright transition-colors">
          {hero.cta1}
        </a>
        <a href="#facilities" class="inline-flex items-center gap-2 border border-gold/50 text-ivory px-6 py-3 rounded-full hover:border-goldBright hover:text-goldBright transition-colors">
          {hero.cta2}
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-5 text-sm text-ivory/80">
        <span class="stars text-lg">★ {siteConfig.rating}</span>
        <span>{siteConfig.reviewCount} {hero.reviewSuffix}</span>
        <span class="hidden sm:inline text-ivory/40">·</span>
        <span>{coordsLabel}</span>
      </div>

      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-goldBright hover:text-gold underline-offset-4 hover:underline text-sm">
        {hero.viewLocation} ↗
      </a>

      <div class="wood-sign mt-8 inline-block max-w-md px-5 py-4">
        <p class="wood-title text-xs font-semibold uppercase tracking-[0.18em]">{hero.boardCategory}</p>
        <p class="wood-title mt-1 font-display text-2xl font-bold leading-tight">{hero.boardTitle}</p>
        <p class="wood-en mt-1 text-sm font-semibold">{hero.boardEn}</p>
      </div>
      <div class="carousel-dots mt-4">
        <span class="dot active"></span>
        <span class="dot"></span>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="weather-card rounded-2xl p-5 text-ivory shadow-2xl">
        <!-- 顶部：实时状态栏 -->
        <div class="flex items-center justify-between flex-wrap gap-2">
          <span class="text-ivory/70 text-sm">{hero.plannerTitle}</span>
          <span class="text-xs text-ivory/55">{weather.ok ? hero.liveWeather : hero.liveWeather}</span>
        </div>

        <!-- 温度主视觉 + 指标行 -->
        <div>
          <div class="flex items-center justify-between mt-3">
            <span class="text-3xl" aria-hidden="true">{weather.icon}</span>
            <div class="text-xs text-right space-y-0.5 text-ivory/75">
              <div class="text-goldBright font-semibold">{weather.title}</div>
              <div><span class="text-gold/90">{hero.extraLabels.uvIndex}</span> <span class="font-semibold text-ivory">{weather.uvText}</span> · <span class="text-gold/90">{hero.extraLabels.humidity}</span> <span class="font-semibold text-ivory">{weather.humText}</span></div>
            </div>
          </div>
          <div class="mt-2 flex items-end gap-3 flex-wrap">
            <span class="font-display text-5xl font-semibold text-goldBright leading-none">{weather.temp}°</span>
            <div class="pb-1">
              <div class="text-sm">
                🌡️ <span class="font-semibold text-ivory">{weather.tMax}°</span>
                <span class="text-ivory/40"> / </span>
                <span class="text-ivory/75">{weather.tMin}°</span>
              </div>
              <div class="text-xs text-ivory/60 mt-0.5 flex flex-wrap gap-x-3 gap-y-0.5">
                <span>💨 {weather.wind} km/h</span>
                <span>💧 {weather.precipProb0}%</span>
              </div>
            </div>
          </div>

          <!-- 风险：置顶红色显示 -->
          {weather.advice.risk.length > 0 && (
            <div class="mt-4 rounded-xl border border-red-500/50 bg-red-500/15 px-4 py-3">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs uppercase tracking-wide text-red-300">{lab.risk}</span>
              </div>
              <ul class="space-y-1.5 text-sm text-red-100">
                {weather.advice.risk.map((r) => (
                  <li class="flex gap-2">
                    <span class="text-red-300 mt-0.5" aria-hidden="true">⚠</span>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- 4 类建议块：不满足的整组完全隐藏 -->
          <div class="mt-4 space-y-3">
            {weather.advice.dressing.length > 0 && (
              <div class="rounded-xl bg-gold/15 border border-gold/30 px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs uppercase tracking-wide text-ivory/70">✅ {lab.dressing}</span>
                </div>
                <ul class="mt-2 space-y-1.5 text-sm font-display font-semibold text-goldBright leading-snug">
                  {weather.advice.dressing.map((s) => (
                    <li class="flex gap-2">
                      <span class="text-goldBright mt-0.5" aria-hidden="true">·</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {weather.advice.schedule.length > 0 && (
              <div class="rounded-xl bg-teal-500/15 border border-teal-400/30 px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs uppercase tracking-wide text-teal-200">✅ {lab.schedule}</span>
                </div>
                <ul class="mt-2 space-y-1.5 text-sm text-teal-50 leading-snug">
                  {weather.advice.schedule.map((s) => (
                    <li class="flex gap-2">
                      <span class="text-teal-200 mt-0.5" aria-hidden="true">·</span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {weather.advice.carry.length > 0 && (
              <div class="rounded-xl bg-ivory/10 border border-ivory/25 px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs uppercase tracking-wide text-ivory/70">🎒 {lab.carry}</span>
                </div>
                <p class="mt-2 text-sm text-ivory leading-relaxed">
                  {weather.advice.carry.join(' · ')}
                </p>
              </div>
            )}

            {weather.advice.risk.length === 0 && (
              <div class="rounded-xl border border-green-400/30 bg-green-500/10 px-4 py-2.5 text-xs text-green-200 flex items-center gap-2">
                <span aria-hidden="true">✓</span>
                <span>{lab.noRisk}</span>
              </div>
            )}
          </div>

          <!-- 黄金时刻/蓝调 -->
          <div class="mt-5 pt-4 border-t border-gold/20">
            <p class="font-hand text-gold text-lg">{hero.lightLabel}</p>
            <p class="text-xs text-ivory/60 mt-0.5">{hero.lightNote}</p>
            <div class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between"><span class="text-ivory/70">{hero.goldenHourLabel}</span><span class="font-semibold text-goldBright">{weather.golden}</span></div>
              <div class="flex justify-between"><span class="text-ivory/70">{hero.sunsetLabel}</span><span class="font-semibold text-goldBright">{weather.sunset}</span></div>
              <div class="flex justify-between"><span class="text-ivory/70">{hero.blueHourLabel}</span><span class="font-semibold text-goldBright">{weather.blue}</span></div>
              <div class="flex justify-between"><span class="text-ivory/70">{hero.crowdWarningLabel}</span><span class="font-semibold text-ivory">{hero.defaultCrowd}</span></div>
            </div>
          </div>

          <!-- 7 日预报 -->
          {weather.days.length > 0 && (
            <div class="mt-5 pt-4 border-t border-gold/20">
              <p class="font-hand text-gold text-lg mb-3">{hero.forecastLabel}</p>
              <div class="grid grid-cols-4 md:grid-cols-7 gap-2 text-center text-xs">
                {weather.days.map((d) => (
                  <div class="rounded-lg border border-gold/20 bg-teak/40 py-2 hover:border-goldBright transition">
                    <div class="text-ivory/60 font-medium">{d.week}</div>
                    <div class="text-lg my-1" aria-hidden="true">{d.icon}</div>
                    <div class="text-ivory/90 font-semibold">{d.hi}°</div>
                    <div class="text-ivory/55">{d.lo}°</div>
                    <div class="mt-1 text-ivory/50">💧 {d.prob}%</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
