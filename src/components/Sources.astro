---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  messages: Record<string, any>;
  lang?: Lang;
}
const { messages, lang } = Astro.props;
const s = messages.sources;
const currentLang = (lang || 'en') as keyof typeof siteConfig.reviewsSyncDate;
const syncDate = siteConfig.reviewsSyncDate[currentLang];
---

<section id="sources" class="py-16 bg-teakDeep text-ivory">
  <div class="max-w-5xl mx-auto px-5">
    <p class="font-hand text-gold text-xl">{s.label}</p>
    <h2 class="font-display text-3xl md:text-4xl mt-1">{s.heading}</h2>
    <p class="mt-4 text-ivory/75 max-w-2xl">{s.intro}</p>

    <div class="grid md:grid-cols-2 gap-8 mt-8">
      <div>
        <h3 class="font-display text-xl text-goldBright">{s.photoTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm text-ivory/80 list-disc list-inside">
          {s.photoItems.map((it) => (
            <li>
              {it.url
                ? <a href={it.url} class="underline hover:text-goldBright" target="_blank" rel="noopener noreferrer">{it.text} — {it.linkLabel}</a>
                : it.text}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-ivory/55 border-t border-gold/15 pt-3">{s.imageCopyright}</p>
      </div>
      <div>
        <h3 class="font-display text-xl text-goldBright">{s.reviewTitle}</h3>
        <p class="mt-3 text-sm text-ivory/80">{(s.reviewText || '').replace(/\{syncDate\}/g, syncDate)}</p>
        <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-goldBright underline hover:underline-offset-4 text-sm">
          {s.reviewLink} ↗
        </a>
      </div>
    </div>

    <div class="mt-8 grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="font-display text-xl text-goldBright">{s.factTitle}</h3>
        <p class="mt-3 text-sm text-ivory/80">{s.factText}</p>
      </div>
      <div class="rounded-2xl border border-gold/30 bg-white/5 p-5">
        <h3 class="font-display text-lg text-goldBright">{s.correctionTitle}</h3>
        <p class="mt-2 text-sm text-ivory/80">{s.correctionText}</p>
        <a
          href={s.correctionMailto}
          class="inline-block mt-3 bg-gold text-teak font-semibold px-5 py-2 rounded-full hover:bg-goldBright transition-colors text-sm"
        >
          {s.correctionCta}
        </a>
      </div>
    </div>

    <div class="mt-8 border-t border-ivory/15 pt-6">
      <h3 class="font-display text-xl text-goldBright">{messages.footer.sourcesTitle}</h3>
      <p class="mt-2 text-sm text-ivory/70">{messages.footer.sourcesNote}</p>
      <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm">
        {siteConfig.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer" class="text-goldBright underline hover:underline-offset-4">{source.name[currentLang]} ↗</a></li>
        ))}
      </ul>
      <nav aria-label="Site policies" class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href={`/${currentLang}/privacy-policy`} class="text-ivory/75 underline hover:text-goldBright">{messages.footer.privacy}</a>
        <a href={`/${currentLang}/terms-of-service`} class="text-ivory/75 underline hover:text-goldBright">{messages.footer.terms}</a>
        <a href={`/${currentLang}/cookie-settings`} class="text-ivory/75 underline hover:text-goldBright">{messages.footer.cookies}</a>
      </nav>
    </div>

    <p class="mt-8 text-xs text-ivory/45">© {new Date().getFullYear()} {s.copyright}</p>
  </div>
</section>
