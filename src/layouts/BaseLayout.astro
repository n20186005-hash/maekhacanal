---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  messages: Record<string, any>;
  path?: string;
  includeSiteAttraction?: boolean;
}
const { lang, title, description, messages, path = '', includeSiteAttraction = true } = Astro.props;
const canonical = `${siteConfig.domain}/${lang}/${path ? `${path}/` : ''}`;

const faqs = !path && messages?.guide?.faqs ? messages.guide.faqs : [];

const allAlternateNames = Array.from(new Set([
  siteConfig.name.th,
  siteConfig.name.en,
  siteConfig.name.zh,
  siteConfig.shortName.th,
  siteConfig.shortName.en,
  siteConfig.shortName.zh,
  `${siteConfig.cityName.en} ${siteConfig.name.en}`,
  `${siteConfig.cityName.th} ${siteConfig.name.th}`,
  `${siteConfig.cityName.zh} ${siteConfig.name.zh}`,
  ...(siteConfig.alternateNames?.en || []),
  ...(siteConfig.alternateNames?.zh || []),
  ...(siteConfig.alternateNames?.th || []),
]));

const jsonLd = [
  ...(includeSiteAttraction ? [{
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `${siteConfig.domain}/#attraction`,
    name: siteConfig.attractionFullName[lang],
    alternateName: allAlternateNames,
    description,
    url: canonical,
    image: [
      `${siteConfig.domain}${siteConfig.ogImage}`,
      `${siteConfig.domain}${siteConfig.heroImage}`,
    ],
    isAccessibleForFree: true,
    publicAccess: true,
    telephone: siteConfig.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.addressStreet,
      addressLocality: siteConfig.addressLocality,
      addressRegion: siteConfig.addressRegion,
      postalCode: siteConfig.postalCode,
      addressCountry: siteConfig.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    hasMap: siteConfig.mapsUrl,
    sameAs: siteConfig.sameAs,
  }] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: htmlLang[lang],
    isPartOf: { '@id': `${siteConfig.domain}/#attraction` },
    about: { '@id': `${siteConfig.domain}/#attraction` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteConfig.countryName[lang], item: `${siteConfig.domain}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: siteConfig.cityName[lang], item: `${siteConfig.domain}/${lang}/` },
      { '@type': 'ListItem', position: 3, name: siteConfig.attractionFullName[lang], item: `${siteConfig.domain}/${lang}/` },
      ...(path ? [{ '@type': 'ListItem', position: 4, name: title, item: canonical }] : []),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`${siteConfig.ogImage}`} />
    <link rel="apple-touch-icon" href={`${siteConfig.ogImage}`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}${siteConfig.ogImage}`} />
    <meta property="og:image:alt" content={`${siteConfig.attractionFullName[lang]} in ${siteConfig.cityName[lang]}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={`${siteConfig.attractionFullName[lang]} in ${siteConfig.cityName[lang]}`} />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}/${path ? `${path}/` : ''}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.domain}/en/${path ? `${path}/` : ''}`} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0d2a2e" />
    <meta name="application-name" content={siteConfig.name[lang]} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name[lang]} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain">
    <slot />
  </body>
</html>
